# Set these in the Portainer stack, never in the repo.
# Required (compose refuses to start without them):
A2A_HARNESS=claude                          # claude | codex: which host socket, <harness>.sock
A2A_DOMAIN=a2a.example.com                  # must match the host instance's public_url
A2A_SOCKET_DIR=/var/lib/a2a-adapter/alice   # that user's socket dir, as created by the ansible role
# openssl rand -hex 32 (lowercase hex, >=32 chars); clients send "Authorization: Bearer <key>".
# The placeholder is deliberately not hex: the container refuses to start with it.
A2A_API_KEY=CHANGE_ME
# Optional:
# TRAEFIK_NETWORK_NAME=traefik_proxy        # external docker network Traefik watches
# TRAEFIK_CERTRESOLVER=letsencrypt
